# Sarmelle Environment Configuration Example
# Copy this file to .env and configure local/production values.
# NEVER commit .env to GitHub or share secrets.

DB_HOST="localhost"
DB_NAME="sarmelle_db"
DB_USER="root"
DB_PASS=""

APP_ENV="development"
APP_URL="http://localhost/sarmelle"

# Payment Gateway (Razorpay / Cashfree Sandbox Credentials)
PAYMENT_GATEWAY="razorpay"
GATEWAY_KEY_ID="rzp_test_placeholder"
GATEWAY_KEY_SECRET="test_secret_placeholder"
WEBHOOK_SECRET="webhook_secret_placeholder"
