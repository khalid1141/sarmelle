# Sarmelle environment template.
# Copy this file to server/private/config/.env on the deployment and fill in the
# values there. The real file is git-ignored and must never sit in a web root.
# One KEY=value per line. Quotes are optional; a # starts a comment only on its
# own line or after whitespace outside quotes.

# --- Application -------------------------------------------------------------
APP_ENV=local
APP_DEBUG=1
APP_URL=http://localhost:3000
ADMIN_URL=http://localhost:8081
# Generate with: php -r "echo base64_encode(random_bytes(32));"
APP_KEY=
APP_TIMEZONE=Asia/Kolkata
APP_TRUSTED_PROXIES=

# --- Database ----------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=sarmelle_db
DB_USER=
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_TIMEZONE=+05:30
DB_SSL=0
DB_SSL_CA=

# --- Customer session --------------------------------------------------------
SESSION_NAME_CUSTOMER=SARM_SESS
SESSION_LIFETIME_CUSTOMER_DAYS=30
SESSION_SAVE_PATH=server/private/var/sessions

# --- Admin cookies and session limits ----------------------------------------
ADMIN_SESSION_COOKIE=SARM_ADMIN_SESSION
ADMIN_DEVICE_COOKIE=SARM_ADMIN_DEVICE
ADMIN_PENDING_COOKIE=SARM_ADMIN_PENDING
ADMIN_CSRF_COOKIE=SARM_ADMIN_CSRF
ADMIN_SESSION_IDLE_MINUTES=30
ADMIN_SESSION_ABSOLUTE_HOURS=12
ADMIN_TRUSTED_DEVICE_DAYS=30

# --- Cookie flags ------------------------------------------------------------
COOKIE_SECURE=0
COOKIE_SAMESITE=Lax

# --- Password hashing --------------------------------------------------------
# auto = Argon2id when the PHP build supports it, otherwise bcrypt at the cost below.
PASSWORD_ALGO=auto
PASSWORD_BCRYPT_COST=12

# --- Mail --------------------------------------------------------------------
# log writes messages to MAIL_LOG_DIR and sends nothing (local dev, no Composer).
MAIL_TRANSPORT=log
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Sarmelle
MAIL_REPLY_TO=
MAIL_LOG_DIR=server/private/var/mail
MAIL_TIMEOUT_SECONDS=10

# --- Requests and logging ----------------------------------------------------
MAX_JSON_BYTES=65536
LOG_DIR=server/private/var/log
LOG_LEVEL=debug

# --- CLI guards --------------------------------------------------------------
# SETUP_ALLOWED=1 only until create-admin.php has run, then back to 0.
# RECOVERY_ALLOWED=1 only while running reset-admin-password.php.
SETUP_ALLOWED=0
RECOVERY_ALLOWED=0

# --- Razorpay (reserved, not read before Milestone 8) ------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
