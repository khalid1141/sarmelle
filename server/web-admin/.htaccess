Options -Indexes

DirectoryIndex index.html

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Deny dotfiles, except ACME challenges.
    RewriteRule (^|/)\.(?!well-known/) - [F,L]

    # The front controller is an implementation detail, not a URL.
    RewriteCond %{THE_REQUEST} \s/+api/index\.php[\s?] [NC]
    RewriteRule ^api/index\.php$ - [F,L]

    # The /api rewrite below maps the request onto api/index.php, and the
    # rewritten request is processed again. Stop that second pass here so the
    # front controller cannot be redirected to itself in a loop.
    RewriteRule ^api/index\.php$ - [L]

    # Every /api and /api/* request goes to the API front controller, even if a
    # real file exists there. This matches server/bin/dev-router.php.
    RewriteRule ^api(/.*)?$ api/index.php [L,QSA]
</IfModule>

<Files "bootstrap-path.php">
    Require all denied
</Files>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "no-referrer"
    Header always set X-Frame-Options "DENY"
</IfModule>
